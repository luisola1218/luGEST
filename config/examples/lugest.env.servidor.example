# MODELO PARA O SERVIDOR PRINCIPAL
# Copiar para lugest.env no servidor e ajustar os valores reais.

LUGEST_DB_HOST=127.0.0.1
LUGEST_DB_PORT=3306
LUGEST_DB_USER=lugest_user
LUGEST_DB_PASS=trocar-password
LUGEST_DB_NAME=lugest

# Pasta partilhada UNC usada por todos os postos.
LUGEST_SHARED_STORAGE_ROOT=\\SERVIDOR\LuGEST\Ficheiros

# Login do proprietario para reautorizar trial/licenciamento.
# A password do OWNER segue em hash e nao revela a password real.
# Mantem a password real do OWNER fora desta pasta.
LUGEST_OWNER_USERNAME=lugestowner
LUGEST_OWNER_PASSWORD=pbkdf2_sha256$260000$a60XPwQWfif6QNuSa2Y-rg$6jAUX6Bofypwjv9LZwsanTIWpQZKdIy0FoLzjXmscpU

# Multi-posto: 0 permite que a licença/trial da base de dados sirva todos os PCs.
# Usa 1 apenas se quiseres bloquear a licença a um único computador.
LUGEST_TRIAL_BIND_DEVICE=0

# IA focada em Produtos e Materia-Prima (opcional).
# Recomendado: aponta os postos para um gateway HTTPS administrado pela LuGEST.
# LUGEST_AI_ENDPOINT=https://ia.exemplo.pt/structured
# LUGEST_AI_ACCESS_TOKEN=token-individual-da-instalacao
#
# IA local gratuita no servidor. Instalar Ollama e executar:
#   ollama pull qwen3:4b
# LUGEST_AI_ENABLED=1
# LUGEST_OLLAMA_URL=http://127.0.0.1:11434
# LUGEST_OLLAMA_MODEL=qwen3:4b
# LUGEST_AI_TIMEOUT_SECONDS=45
#
# OpenAI opcional para interpretação avançada. Nunca colocar uma chave comercial
# nos postos; configurar apenas no servidor/gateway controlado.
# LUGEST_OPENAI_API_KEY=chave-do-projeto-openai
# LUGEST_OPENAI_MODEL=gpt-5.6-sol
# LUGEST_OPENAI_BASE_URL=https://api.openai.com/v1
#
# Teste direto no servidor (nao distribuir esta chave pelos postos):
# LUGEST_GEMINI_API_KEY=chave-do-google-ai-studio
# LUGEST_GEMINI_MODEL=gemini-3.6-flash

# Opcional: bootstrap de contingencia se a tabela users estiver vazia.
# LUGEST_BOOTSTRAP_ADMIN_USERNAME=admin_inicial
# LUGEST_BOOTSTRAP_ADMIN_PASSWORD=PasswordMuitoForte#2026
# LUGEST_BOOTSTRAP_ADMIN_ROLE=Admin

# Opcional: metadados fiscais / SAF-T(PT)
# LUGEST_SOFTWARE_CERT_NUMBER=
# LUGEST_SOFTWARE_PRODUCER_NAME=LuGEST
# LUGEST_SOFTWARE_PRODUCER_NIF=
# LUGEST_SOFTWARE_PRODUCT_ID=LuGEST
# LUGEST_SOFTWARE_PRODUCT_VERSION=2026.04
# LUGEST_HASH_CONTROL=1
# LUGEST_FISCAL_PRIVATE_KEY=generated/compliance/keys/lugest_fiscal_private.pem
# LUGEST_FISCAL_PUBLIC_KEY=generated/compliance/keys/lugest_fiscal_public.pem
